{
  "name": "dsh-qq-console",
  "version": "1.0.2",
  "license": "MIT",
  "author": "dsh-qq-console contributors",
  "type": "module",
  "description": "大肥鱼 QQ 总控台：把 SnowLuma、QQ 桥接和聊天状态合成 DSH 里的一个中文页面。",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.svg", "INSTALL.md", "README.md", "AGENTS.md"],
  "repository": { "type": "git", "url": "git+https://github.com/zjw0011/dsh-qq-console.git" },
  "homepage": "https://github.com/zjw0011/dsh-qq-console#readme",
  "bugs": { "url": "https://github.com/zjw0011/dsh-qq-console/issues" },
  "keywords": ["dsh", "deepseek-harness", "plugin", "qq", "onebot", "snowluma", "qq-bridge"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "test": "node test/rendercheck.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
